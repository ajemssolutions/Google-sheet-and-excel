# Copy this file to ".env" and fill in the three Google values.
# The AJEMS URL and secret key are entered in the UI, not here.
#
# Google is only needed for Google Sheets. Uploading an Excel or CSV file
# works without any of this.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Cloud > Credentials > API key. Needed to render Google's file picker.
GOOGLE_API_KEY=your-api-key

# Must match the Authorised redirect URI in the Google Cloud console exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

PORT=3000
